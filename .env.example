# Copy this file to .env and fill in your values.

# From the Discord Developer Portal -> your application -> Bot -> Token
DISCORD_TOKEN=

# From the Discord Developer Portal -> your application -> General Information -> Application ID
CLIENT_ID=

# Optional: set this while testing so slash commands register instantly to one server
# instead of up to an hour for global commands. Remove it (or leave blank) once you
# want the bot available with global commands across all its servers.
GUILD_ID=
